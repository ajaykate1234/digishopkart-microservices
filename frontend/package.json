{
  "name": "digishopkart-ui",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve frontend",
    "start:catalog": "ng serve catalog",
    "start:account": "ng serve account",
    "start:checkout": "ng serve checkout",
    "start:offers": "ng serve offers",
    "start:all": "concurrently -k -n shell,catalog,account,checkout,offers \"npm run start\" \"npm run start:catalog\" \"npm run start:account\" \"npm run start:checkout\" \"npm run start:offers\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.4",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.4",
    "@softarc/native-federation-orchestrator": "^4.8.0",
    "concurrently": "^9.2.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
